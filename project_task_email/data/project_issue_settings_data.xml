<?xml version="1.0" encoding="UTF-8"?>
<odoo>

        <!-- QWeb template for email received autoreply -->
        <template id="project_issue_email_received_autoreply" name="Issue received autoreply email">
            <div style="width:100%;background-color:#eae8e8">
                <table style="max-width:656px;margin:0 auto" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#eae8e8">
                    <tbody>
                        <tr>
                            <td width="656" bgcolor="white">
                                <div style="background-color:white;font-family:Helvetica,Arial,Verdana;line-height:1.5">
                                    <t t-call="project_issue_email.project_issue_email_header"/>

                                    <!-- Body -->
                                    <div style="padding:0 22px;margin:0 28px">
                                        <p>Thank your for contacting <t t-esc="object.company_id.name"/> support. This is an automated message that your ticket  <strong><t t-esc="'#%s: %s' % (object.issue_code,object.name)"/></strong> has been received. We will reply to you as soon as possible.</p>
                                        <p>Please make sure that the ticket ID is kept in the subject of the emails so your ticket is tracked properly.</p>
                                        <hr style="color: #f6f6f6"/>
                                        <div style="margin:20px 0;">
                                            <p style="margin-bottom:20px;color:#909090;">Author: <t t-esc="object.partner_id.name"/>,
                                                <span t-field="object.create_date" t-options="{'format': 'dd.MM.yyyy HH:mm'}"/>
                                            </p>
                                            <b>Issue description:</b><br/>
                                            <div t-field="object.description"/>
                                        </div>
                                        <hr style="color: #f6f6f6"/>
                                    </div>

                                    <t t-call="project_issue_email.project_issue_email_footer"/>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </template>


        <!-- QWeb template for issue reply by employees -->
        <template id="project_issue_email_reply" name="Email template for replying to customer">
            <div id="issue_reply" style="width:100%;background-color:#eae8e8">
                <table style="max-width:656px;margin:0 auto" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#eae8e8">
                    <tbody>
                        <tr>
                            <td width="656" bgcolor="white">
                                <div style="background-color:white;font-family:Helvetica,Arial,Verdana;line-height:1.5">
                                    <t t-call="project_issue_email.project_issue_email_header"/>

                                    <!-- Body -->
                                    <div
                                         style="padding:0 22px;margin:0 28px">
                                        <div id="portal-header" t-if="object.partner_id.user_id and object.partner_id.user_id.has_group('base.group_portal')">
                                            <div style="font-weight:bold;font-size:22px;margin:32px 0">
                                                Hey
                                            </div>
                                            <p>There's a new message for your ticket  <strong><t t-esc="'#%s: %s' % (object.issue_code, object.name)"/></strong>. You can see the response below in the next section or in <a t-att-href="object.env['ir.config_parameter'].sudo().get_param('web.base.url') + '/my/issues/' + str(object.id)" target="_blank" rel="noopener noreferrer">the website portal</a> by signing in to your account. If you don't have a portal account and would prefer using it instead of emails, you can request it from us.</p>
                                        </div>
                                        <p>Please make sure that the ticket ID is kept in the subject of the emails so your ticket is tracked properly.</p>
                                        <hr style="color: #f6f6f6"/>
                                        <div style="padding 2em 0; margin: 2em 0">
                                            <div id="message-content"></div>
                                        </div>
                                        <hr style="color: #f6f6f6"/>
                                    </div>

                                    <div t-if="object.latest_message_id" style='margin-top:30px;padding-left:40px; border-left:solid 3px #ccc;'>
                                        <h3>Latest message</h3>
                                        <span style='margin-bottom:20px;color:#909090;'>Author:</span>
                                         <span t-field="object.latest_message_id.author_id" /> (<span t-field="object.latest_message_id.create_date" />):
                                        <br />
                                        <div t-field="object.latest_message_id.body"></div>
                                    </div>

                                    <t t-call="project_issue_email.project_issue_email_footer"/>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </template>

        <!--Default Issue Received Email template -->
        <record id="mail_template_project_issue_received_email" model="mail.template">
            <field name="name">Project Issue Received Email</field>
            <field name="subject">${object.subject}</field>
            <field name="lang">${object.partner_id.lang}</field>
            <field name="model_id" ref="project_issue_email.model_project_issue"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_type">qweb</field>
            <field name="body_view_id" ref="project_issue_email.project_issue_email_received_autoreply"/>
        </record>


        <!--Default Issue Reply Email template -->
        <record id="mail_template_project_issue_reply_email" model="mail.template">
            <field name="name">Project Issue Reply Email</field>
            <field name="subject">${object.subject}</field>
            <field name="lang">${object.partner_id.lang}</field>
            <field name="model_id" ref="project_issue_email.model_project_issue"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_type">qweb</field>
            <field name="body_view_id" ref="project_issue_email.project_issue_email_reply"/>
        </record>
</odoo>
