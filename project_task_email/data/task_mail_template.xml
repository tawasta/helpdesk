<odoo>

    <!-- Template for autoreply content -->
    <template id="helpdesk_autoreply_content" name="Helpdesk autoreply content">
        <div style="padding:0 22px;margin:0 28px">
            <p>Thank your for contacting <t t-esc="object.company_id.name"/> support.</p>
            <p>This is an automated message that your ticket <strong t-field="object.display_name"/> has been received.</p>
            <p>We will reply to you as soon as possible.</p>
            <p>Please make sure that the ticket ID is kept in the subject of the emails so your ticket is tracked properly.</p>

            <hr style="color: #f6f6f6"/>
            <p style="margin-bottom: 2em; color:#909090;"><t t-esc="object.partner_id.name"/> (<span t-field="object.create_date" t-options="{'format': 'dd.MM.yyyy HH:mm'}"/>):</p>

            <span t-raw="object.description" />
            <hr style="color: #f6f6f6"/>
        </div>
    </template>

    <!-- Template for helpdesk autoreply -->
    <record id="mail_template_task_reception" model="mail.template">
        <field name="name">Task Received Autoreply</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="subject">${object.subject}</field>
        <field name="use_default_to" eval="True"/>
        <field name="body_type">qweb</field>
        <field name="body_view_id" ref="project_task_email.helpdesk_autoreply_content"/>
        <field name="auto_delete" eval="True"/>
        <field name="user_signature" eval="False"/>
    </record>

</odoo>