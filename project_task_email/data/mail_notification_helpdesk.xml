<odoo noupdate="0">

    <template id="mail_notification_helpdesk">

        <html t-att-lang="lang">
            <header>
                <meta http-equiv="Content-Type" content="text/html charset=UTF-8" />
            </header>
            <body>

                <table
                    role="presentation"
                    border="0"
                    cellpadding="0"
                    cellspacing="0"
                    style="padding-top: 16px;
                       font-family:Verdana, Arial,sans-serif;
                       color: #454748;
                       width: 100%;
                       border-collapse:separate;"
                >
                    <tbody>
                        <!-- HEADER -->
                        <tr>
                            <td>

                                <!--
                                <span style="font-size: 20px; font-weight: bold;">
                                    <span
                                        t-esc="message.record_name and message.record_name.replace('/','-') or ''"
                                    />
                                </span>
                                -->

                                <t
                                    t-set="subtype_internal"
                                    t-value="subtype.internal"
                                />
                            </td>
                        </tr>
                        <!-- CONTENT -->
                        <tr>
                            <td>
                                <div t-field="message.body" />
                            </td>
                        </tr>

                        <!-- SIGNATURE -->
                        <tr t-if="record.env.user.sudo().signature">
                            <td>
                                <p t-field="record.env.user.sudo().signature" />
                            </td>
                        </tr>

                    </tbody>
                </table>

                <!-- FOOTER -->
                <t
                    t-set="object"
                    t-value="record"
                />

                <t t-call="project_task_email.helpdesk_email_footer" />

                <ul t-if="tracking_values">
                    <t t-foreach="tracking_values" t-as="tracking">
                        <li><t t-esc="tracking[0]" />:
                            <t t-esc="tracking[1]" /> &#8594;
                            <t t-esc="tracking[2]" />
                        </li>
                    </t>
                </ul>

            </body>
        </html>

    </template>

</odoo>
