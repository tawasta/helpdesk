<odoo noupdate="0">
    <template id="helpdesk_autoreply_content" name="Helpdesk autoreply content">
        <div style="width:100%;background-color:#eae8e8">
            <table
                style="max-width:656px;margin:0 auto"
                width="100%"
                cellspacing="0"
                cellpadding="0"
                border="0"
                bgcolor="#eae8e8"
            >
                <tbody>
                    <tr>
                        <td width="656" bgcolor="white">
                            <div
                                style="background-color:white;font-family:Helvetica,Arial,Verdana;line-height:1.5"
                            >
                                <t t-call="project_task_email.helpdesk_email_header" />

                                <!-- Body -->
                                <div style="margin:2rem">
                                    <p>Thank your for contacting
                                        <t t-esc="object.company_id.name" />
                                        support.
                                    </p>
                                    <br />
                                    <p>This is an automated message that your message
                                        <strong t-field="object.display_name" />
                                        has been received.
                                    </p>

                                    <p>We will reply to you as soon as possible.</p>
                                    <p
                                    >Please do not alter the subject of the message, so it will be tracked properly.
                                    </p>

                                    <hr style="color: #f6f6f6" />
                                    <div style="margin:20px 0;">
                                        <p style="margin-bottom:2rem;color:#909090;">
                                        <t t-esc="object.partner_id.name" />,
                                            <span
                                                t-field="object.create_date"
                                                t-options="{'format': 'dd.MM.yyyy HH:mm'}"
                                            />
                                        </p>
                                        <div t-field="object.description" />
                                    </div>
                                    <hr style="color: #f6f6f6" />
                                </div>

                                <t t-call="project_task_email.helpdesk_email_footer" />
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <record id="mail_template_helpdesk_autoreply" model="mail.template">
        <field name="name">Helpdesk: Reception Acknowledgment</field>
        <field name="model_id" ref="project.model_project_task" />
        <field name="subject">${object.display_name} received</field>
        <field name="email_from">${(object.company_id.email or '') | safe}</field>
        <field name="use_default_to" eval="True" />
        <field name="body_type">qweb</field>
        <field
            name="body_view_id"
            ref="project_task_email.helpdesk_autoreply_content"
        />
        <field name="lang">${object.partner_id.lang or 'en_US'}</field>
        <field name="auto_delete" eval="True" />
    </record>

</odoo>
