<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Overwrite project rule so that portal users can create issues -->
        <record id="portal_project_rule" model="ir.rule">
            <field name="name">Project: portal users: portal tickets</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[('privacy_visibility', '=', 'portal')]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="portal_project_issue_rule" model="ir.rule">
            <field name="name">Project issue: portal users: portal tickets</field>
            <field name="model_id" ref="project_issue.model_project_issue"/>
            <field name="domain_force">[('partner_id.id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
