<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add button to create a new issue from website -->
    <template id="my_issues" inherit_id="website_project_issue.my_issues">
        <xpath expr="//h3[@class='page-header']/div[@class='dropdown pull-right mr8']" position="before">
            <div class="create-issue pull-right">
                <button type="button" class="btn btn-primary btn-circle"
                    data-toggle="modal" data-target="#issue_modal"
                    title="Create an issue"><i class="fa fa-plus"/></button>
            </div>
        </xpath>

        <xpath expr="//t[@t-call='website_portal.portal_layout']" position="inside">
            <t t-call="website_project_issue_form.create_issue_template"/>
            <link rel='stylesheet' href='/website_project_issue_form/static/src/css/website_project_issue_form.css'/>
        </xpath>
    </template>

    <!-- Template for creating an issue from website -->
    <template id="create_issue_template" name="Create issue form">
        <div id="issue_modal" class="modal fade" role="dialog">
            <div class="modal-dialog">
                <form id="issue_form" method="post" role="form" class="form-horizontal"
                    action="/my/issues/create" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token(time_limit=False)"/>
                    <t t-set="attachment_max_size" t-value="int(request.env['ir.config_parameter'].get_param('website_project_issue_extension.attachment_max_size'))"/>
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">x</button>
                            <h4 class="modal-title">Create an Issue</h4>
                        </div>
                        <div class="modal-body">
                            <div class="container">
                                <div class="row">
                                    <div class="col-md-6 mb8">
                                        <label for="issue_name">Name:</label>
                                        <input type="text" name="issue_name" id="issue_name" class="form-control"
                                            placeholder="Issue's name" title="Issue's name" required="true" />
                                        <p id="issue_name_error" class="hidden has-error mt8">Field can't be empty!</p>
                                    </div>

                                    <div class="col-md-6 mb8">
                                        <label for="issue_email">Support email:</label>
                                        <select class="form-control" id="issue_email" name="issue_email" required="true">
                                            <option value="">Select support address...</option>
                                            <t t-set="mail_servers" t-value="website.env['fetchmail.server'].sudo().search([])"/>
                                            <t t-foreach="mail_servers" t-as="server">
                                                <option t-att-value="server.company_id.id"><t t-esc="server.company_id.name"/></option>
                                            </t>
                                        </select>
                                        <p id="issue_email_error" class="hidden has-error mt8">Field can't be empty!</p>
                                    </div>
                                    <div class="col-md-12 mb8">
                                        <label for="issue_recipients">Recipients' email addresses (separated with comma):</label>
                                        <input type="text" name="issue_recipients" id="issue_recipients"
                                            class="form-control" placeholder="Recipients' email addresses"
                                            title="Recipients' email addresses" />
                                        <p id="issue_recipients_error" class="hidden has-error mt8">Please check the format: email addresses separated with commas!</p>
                                    </div>
                                    <div class="col-md-12 issue-summary">
                                        <label for="issue_summary">Description of issue:</label>
                                        <textarea id="issue_summary" name="issue_summary" placeholder="Explain issue..."
                                            class="col-xs-12" rows="5"/>
                                        <p id="issue_summary_error" class="hidden has-error mt8">Field can't be empty!</p>
                                    </div>
                                    <div class="col-md-12">
                                        <h4>Attachment</h4>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="fileUpload btn btn-default col-xs-6">
                                            <span><i class="fa fa-folder-open"/>  Attach File</span>
                                            <input name="issue_attachments" type="file" id="issue_attachments" class="upload" multiple="true"
                                                t-att-data-maxsize="attachment_max_size"/>
                                        </div>
                                        <div class="clearfix" />
                                        <div id="attachment_info_div" class="hidden alert mt8"></div>
                                    </div>
                                </div>
                            </div> <!-- .container ends -->
                        </div> <!-- .modal-body ends -->
                        <div class="modal-footer">
                            <button id="submit_issue" class="btn btn-primary" type="button">Create</button>
                            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <script src="//cdn.ckeditor.com/4.8.0/standard-all/ckeditor.js"></script>
        <script type="text/javascript" src="/website_project_issue_form/static/src/js/create_issue.js?v=004"></script>
        <script type="text/javascript" src="/website_project_issue_form/static/src/js/attachment.js?v=003"></script>
    </template>
</odoo>
