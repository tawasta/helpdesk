<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action -->
    <record id="project_issue_state_change_action"
            model="ir.actions.act_window">
        <field name="name">Stage changes</field>
        <field name="res_model">project.issue.stage.change</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
        <field name="view_id" eval="False"/>
        <field name="context">{'search_default_year_this': 1, 'search_default_month_last': 1, 'search_default_month_this': 1}</field>
    </record>

    <!-- Tree -->
    <record model="ir.ui.view" id="project_issue_stage_change_tree">
        <field name="name">Issue stage changes tree view</field>
        <field name="model">project.issue.stage.change</field>
        <field name="arch" type="xml">

            <tree string='Stage changes' readonly='1'
                  default_order='id DESC'>
                <field name='issue_partner_id'/>
                <field name='issue_date'/>
                <field name='issue_id'/>
                <field name='new_stage_id' string='Stage'/>
                <field name='hours' widget="float_time" sum='Total hours'/>
            </tree>

        </field>
    </record>

    <!-- Graph -->
    <record model="ir.ui.view" id="project_issue_stage_change_graph">
        <field name="name">Issue stage changes graph view</field>
        <field name="model">project.issue.stage.change</field>
        <field name="arch" type="xml">

            <graph string="Issue Analysis" type="pivot">
                 <field name="issue_partner_id" type="row"/>
                 <field name="hours" type="measure"/>
                 <field name="issue_date" interval="month" type="col"/>
             </graph>
        </field>
    </record>

    <!-- Search -->
    <record model="ir.ui.view" id="project_issue_stage_change_filters">
        <field name="name">Issue stage changes filters view</field>
        <field name="model">project.issue.stage.change</field>
        <field name="arch" type="xml">

            <search string="Search stage changes">
                <field name="issue_id" />
                <field name="issue_partner_id" />
                <field name="new_stage_id" />

                <separator />

                <group string="Year">
                        <filter string="This year"
                                name="year_this"
                                domain="['&amp;',('issue_date','&lt;=', time.strftime('%Y-12-31')),('issue_date','&gt;=',time.strftime('%Y-01-01'))]"/>
                        <filter string="Last year"
                                name="year_last"
                                domain="[('issue_date','&gt;=',(context_today()-relativedelta(years=1)).strftime('%Y-01-01')),('issue_date','&lt;', time.strftime('%Y-01-01'))]"/>
                </group>
                <group string="Month">
                    <filter string="This month"
                            name="month_this"
                            domain="[('issue_date','&lt;',(context_today()+relativedelta(months=1)).strftime('%Y-%m-01')), ('issue_date','&gt;=',time.strftime('%Y-%m-01'))]"/>
                    <filter string="Last month"
                            name="month_last"
                            domain="[('issue_date','&gt;=',(context_today()-relativedelta(months=1)).strftime('%Y-%m-01')),('issue_date','&lt;',time.strftime('%Y-%m-01'))]"/>
                </group>

                <group expand="0" string="Group By">
                    <filter name="groupby_issue_partner" string="Issue partner" context="{'group_by':'issue_partner_id'}"/>
                    <filter name="groupby_issue" string="Issue" context="{'group_by':'issue_id'}"/>
                    <filter name="groupby_stage" string="Stage" context="{'group_by':'stage'}"/>
                </group>
            </search>

        </field>
    </record>

    <!-- Menuitem(s) -->
    <menuitem id="stage_changes_menu" name="Stage changes"
              parent="project_issue_menu.project_issue_menu"
              action="project_issue_state_change_action" sequence="99"/>
</odoo>