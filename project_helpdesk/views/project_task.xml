<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <record id="view_task_search_form" model="ir.ui.view">
        <field name="name">project.task.search.form.helpdesk</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <filter name="unassigned" position="after">
                <separator />
                <filter
                    string="Open"
                    name="is_open"
                    domain="[('is_closed', '=', False)]"
                />
            </filter>
        </field>
    </record>
    <record id="view_task_tree2_helpdesk" model="ir.ui.view">
        <field name="name">project.task.tree.helpdesk</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field name="create_date" optional="show" />
                <field name="__last_update" optional="show" />
                <field name="priority" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
