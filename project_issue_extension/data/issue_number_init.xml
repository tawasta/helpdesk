<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <record id="sequence_issue" model="ir.sequence">
            <field name="name">Issue number sequence</field>
            <field name="code">project.issue</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
        </record>
        <!-- Initialize issue numbers for all existing issues upon module installation -->
        <function model="project.issue" name="_init_issue_numbers"/>

    </data>
</odoo>
