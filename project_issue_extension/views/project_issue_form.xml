<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="project_issue_form_view_inherited" model="ir.ui.view">
        <field name="name">project.issue.form.view</field>
        <field name="model">project.issue</field>
        <field name="inherit_id" ref="project_issue.project_issue_form_view"/>
        <field name="arch" type="xml">
            <!-- Issue number as heading -->
            <div class="oe_title" position="replace">
                <div class="oe_title">
                    <h1>Issue #<field name="issue_number" readonly="1"/></h1>
                </div>
            </div>

            <!-- Add button for attachements -->
            <button name="toggle_active" position="before">
                <button class="oe_stat_button" name="attachment_tree_view" type="object" icon="fa-files-o">
                    <field string="Documents" name="doc_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" name="customer_issues_tree_view" type="object" icon="fa-ticket"
                    attrs="{'invisible': [('partner_id','=',False)]}">
                    <field string="Issues" name="customer_issue_count" widget="statinfo"/>
                </button>
            </button>

            <field name="user_id" position="before">
                <field name="company_id" readonly="1" groups="base.group_user"/>
            </field>

            <xpath expr="//notebook/page[1]" position="replace">
                <page string="Description">
                    <group name="issue" string="Issue" col="4">
                        <field name="date"/>
                        <field name="date_deadline"/>
                        <field name="name" colspan="4" string="Issue's subject"/>
                        <field name="description" string="Issue's description" colspan="4" />
                    </group>
                </page>
            </xpath>

            <!-- Tree view to follow issue's lifecycle -->
            <notebook position="inside">
                <page string="Stage changes">
                    <field name="stage_change_ids">
                        <tree>
                            <field name='create_uid' />
                            <field name='create_date' />
                            <field name='stage' />
                            <field name='hours' widget="float_time"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
