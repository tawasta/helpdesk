<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="project_issue_form_view" model="ir.ui.view">
        <field name="name">project.issue.form.view</field>
        <field name="model">project.issue</field>
        <field name="inherit_id" ref="project_issue.project_issue_tree_view"/>
        <field name="arch" type="xml">
            <!-- Hide ID-field and show issue_number -->
            <field name="id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="id" position="before">
                <field name="issue_number" string="#"/>
            </field>
            <field name="name" position="attributes">
                <attribute name="string">Issue's subject</attribute>
            </field>
        </field>
    </record>
</odoo>
