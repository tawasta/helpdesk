<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.form.view.first.response</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <field name="date_last_stage_update" position="after">
                <field
                    name="date_reply"
                    groups="base.group_no_one"
                    attrs="{'invisible': [('date_reply', '=', False)]}"
                />
                <field
                    name="working_hours_reply"
                    attrs="{'invisible': [('working_hours_reply', '=', 0.0)]}"
                />
                <field
                    name="working_days_reply"
                    attrs="{'invisible': [('working_days_reply', '=', 0.0)]}"
                />
            </field>
        </field>
    </record>
</odoo>
