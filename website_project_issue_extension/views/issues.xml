<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Modifications to my_issues -template from core -->
    <template id="my_issues" inherit_id="website_project_issue.my_issues">
        <xpath expr="//h3[@class='page-header']" position="before">
            <t t-set="additional_title">My Issues</t>
        </xpath>
        <!-- Add responsive table class -->
        <xpath expr="//div[@class='panel panel-default']" position="attributes">
            <attribute name="class">panel panel-default table-responsive</attribute>
        </xpath>

        <!-- Hide projects filter -->
        <xpath expr="//button[@id='project_filters']/.." position="replace" />

        <xpath expr="//button[@id='sortby']" position="replace">
            <button id="sortby" class="btn btn-default" type="button" data-toggle="dropdown">
                <t t-set="label">Newest</t>
                <span class="fa fa-sort" /> <span t-esc="sortings.get(sortby, {}).get('label', label)"/>
                <span class="caret"></span>
            </button>
        </xpath>


        <!-- Replace table -->
        <xpath expr="//div/table" position="replace">
            <table t-att-class="'table table-hover status_table' if issues else 'table table-hover status_table hidden'">
                <thead>
                    <tr class="active">
                        <th class="col-xs-1">#</th>
                        <th class="col-xs-7">Issue's subject</th>
                        <th class="col-xs-3">Updated on</th>
                        <th class="col-xs-1">Stage</th>
                    </tr>
                </thead>
                <t t-foreach="issues" t-as="issue">
                    <tr>
                        <td>
                            <a t-attf-href="/my/issues/#{issue.id}?{{ keep_query() }}"><t t-esc="issue.issue_number" /></a>
                        </td>
                        <td><span t-field="issue.name"/></td>
                        <td><span t-field="issue.write_date" t-options='{"format": "dd.MM.yyyy HH:mm"}'/></td>
                        <td>
                            <span t-attf-class="label label-#{issue.stage_id.website_label_class}"
                                title="Current stage of the issue" t-esc="issue.stage_id.public_name" />
                        </td>
                    </tr>
                </t>
            </table>
        </xpath>

        <t t-call="website_portal.portal_layout" position="inside">
            <link rel='stylesheet' href='/website_project_issue_extension/static/src/css/issues.css'/>
        </t>
    </template>
</odoo>
