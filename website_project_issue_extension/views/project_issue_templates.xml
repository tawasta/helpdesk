<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="my_issues_issue" inherit_id="website_project_issue.my_issues_issue">
        <!-- Add issue number to heading -->
        <xpath expr="//div[@class='panel-heading']/div/div/h4" position="replace">
            <t t-set="additional_title">My Issue</t>  
            <h4>
                Issue #<span t-field="issue.issue_number"/>: <span t-field="issue.name"/>
                <a class="btn btn-info"
                    t-att-href="'/web#return_label=Website&amp;model=project.issue&amp;id=%s&amp;view_type=form' % (issue.id)"
                    groups="project.group_project_user">Edit Issue</a>
                <span t-field="issue.stage_id.name" t-attf-class="pull-right label label-#{issue.stage_id.website_label_class}"
                    title="Current stage of this issue"/>
            </h4>
            <span t-field="issue.create_date" t-options='{"format": "dd.MM.yyyy HH:mm"}'/>
        </xpath>

        <!-- Rewrote panel body -->
        <xpath expr="//div[@class='panel-body']" position="replace">
            <div class="panel-body">
                <div class='row'>
                    <div class="col-md-4 ticket-user">
                        <strong>Reported by</strong>
                        <div t-if="issue.partner_id">
                            <address t-field="issue.partner_id" t-options='{"widget": "contact", "fields": ["name", "email"], "no_marker": True}'/>
                        </div>
                    </div>
                    <div class="col-md-4 ticket-followers">
                        <strong>Followers</strong>
                        <div>
                            <t t-foreach="issue.message_follower_ids" t-as="follower">
                                <span t-field="follower.sudo().partner_id.email"/><br/>
                            </t>
                        </div>
                    </div>
                    <div class="col-md-4 ticket-handler" t-if="issue.user_id">
                        <strong>Assigned to</strong>
                        <div>
                            <address t-field="issue.user_id" t-options='{"widget": "contact", "fields": ["name", "email", "phone"], "no_marker": True}'/>
                        </div>
                    </div>
                    <t t-if="issue.description">
                        <div class="col-md-12 ticket-description">
                            <strong>Description</strong>
                            <div t-field="issue.description"/>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>

        <!-- Create new submission form for new messages-->
        <xpath expr="//div[@class='panel panel-default']" position="after">
            <t t-call="website_project_issue_extension.issue_submit_message"/>
        </xpath>

        <!-- Replace generic message thread -->
        <xpath expr="//div[@class='row mt32']/div[@class='col-md-10 col-md-offset-1 mt16']" position="replace">
            <div class="col-md-12 mt16">
                <t t-call="website_project_issue_extension.issue_message_thread"/>
            </div>
        </xpath>
    </template>

    <!-- Modifications to my_issues -template from core -->
    <template id="my_issues" inherit_id="website_project_issue.my_issues">

        <!-- Add responsive table class -->
        <xpath expr="//div[@class='panel panel-default']" position="attributes">
            <attribute name="class">panel panel-default table-responsive</attribute>
        </xpath>

        <!-- Remove t-if so that table is rendered but hidden -->
        <xpath expr="//div/table" position="attributes">
            <attribute name="t-if"></attribute>
            <attribute name="class"></attribute>
            <attribute name="t-att-class">'table table-hover status_table' if issues else 'table table-hover status_table hidden'</attribute>
        </xpath>

        <!-- Replace table head row -->
        <xpath expr="//div/table/thead/tr[@class='active']" position="replace">
            <tr class="active">
                <th>#</th>
                <th class="col-md-8">Issue's subject</th>
                <th>Stage</th>
            </tr>
        </xpath>

        <xpath expr="//t[@t-foreach='issues']/tr/td[1]/a" position="replace">
            <a t-attf-href="/my/issues/#{issue.id}?{{ keep_query() }}"><t t-esc="issue.issue_number" /></a>
        </xpath>

        <xpath expr="//t[@t-foreach='issues']/tr/td[3]/span" position="attributes">
            <attribute name="class"></attribute>
            <attribute name="t-attf-class">label label-#{issue.stage_id.website_label_class}</attribute>
        </xpath>

        <t t-call="website_portal.portal_layout" position="inside">
            <link rel='stylesheet' href='/website_project_issue_extension/static/src/css/issues.css'/>
        </t>
    </template>

    <!-- Template for submitting messages -->
    <template id="issue_submit_message" name="Template for submitting messages">
        <div>
            <form id="issue_message_submit_form" t-attf-action="/my/issues/#{issue.id}/message"
                method="post" enctype="multipart/form-data">
                <input type="hidden" name="timestamp" id="timestamp" t-att-value="time.time()"/>
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token(time_limit=False)"/>
                <div class="msg-comment">
                    <textarea id="comment"
                    name="comment"
                    placeholder="Type a message..."
                    class="col-xs-12"
                    rows="5" 
                    oninput="checkField();"/>
                </div>
                <div id="attachment_div" class="clearfix">
                    <div class="fileUpload btn btn-default col-xs-6">
                        <span><i class="fa fa-folder-open"/>  Attach Files</span>
                        <t t-set="attachment_maxsize" 
                            t-value="request.env['ir.config_parameter'].get_param('website_project_issue_extension.attachment_max_size')"/>
                        <input name="attachment_ids" class="upload" type="file" id="attachment_ids"
                            multiple="multiple" t-att-data-maxsize="attachment_maxsize"/>
                    </div>
                    <button id="submit_message" type="button" class="btn btn-primary col-xs-6" title="Submit message"><i class="fa fa-envelope"/> Submit</button>
                </div>
                <div id="attachment_info_div" class="hidden alert mt8"></div>
                <p id="comment_error" class="hidden has-error mt8 mb0">Message field can't be empty!</p>
            </form>
        </div>
        <div class="clearfix"/>
        <link rel='stylesheet' href='/website_project_issue_extension/static/src/css/thread.css'/>
        <script src="//cdn.ckeditor.com/4.8.0/standard-all/ckeditor.js"></script>
        <script type="text/javascript" src="/website_project_issue_extension/static/src/js/website_project_issue.js"></script>
    </template>


    <!-- Template for project issue's thread in portal -->
    <template id="issue_message_thread" name="Message thread for issues">
        <t t-set="message_subtype_id" t-value="request.env.ref('mail.mt_comment').id"/>
        <div id="issue_messages" t-att-data-interval="polling_interval">
            <t t-foreach="issue.message_ids" t-as="message">
                <t t-call="website_project_issue_extension.single_message_template">
                    <t t-set="message" t-value="message"/>
                    <t t-set="message_subtype_id" t-value="message_subtype_id"/>
                </t>
            </t>
        </div>
        <script type="text/javascript" src="/website_project_issue_extension/static/src/js/preview_image.js?002"></script>
    </template>

    <!-- Single message will be rendered using this template -->
    <template id="single_message_template" name="Template for a single message">
        <t t-if="message.subtype_id.id == message_subtype_id and message.website_published">
            <div class="row mb16 message">
                <div class="col-md-1 col-xs-3 mt16">
                    <img class="img img-responsive img-circle" t-attf-src="/mail/#{message.model}/#{message.res_id}/avatar/#{message.author_id.id}" alt="partner image"/>
                </div>
                <div class="col-md-11 col-xs-9">
                    <h4>
                        <span t-field="message.author_id"/>  <small t-field="message.date" t-options='{"format": "dd.MM.yyyy HH:mm:ss"}'/>
                    </h4>
                    <p t-raw="message.body"/>
                    <t t-foreach="message.attachment_ids" t-as="attachment">
                        <!-- Show image attachment -->
                        <t t-if="'image/' in attachment.mimetype">
                            <!-- Images are loaded lazily when scrolled into the view -->
                            <img class="img img-responsive msg-img" t-att-data-src="'/web/content/%s' % (attachment.id)" alt="No image"/>
                        </t>
                        <!-- File attachment and download -->
                        <t t-if="'image/' not in attachment.mimetype">
                            <div class="attachment-mime-image">
                                <a t-att-href="'/web/content/%s?download=1' % (attachment.id)">
                                    <div class="o_image" t-att-data-mimetype="'%s' % (attachment.mimetype)"></div>
                                    <br/>
                                    <t t-esc="attachment.name"/>
                                </a>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </template>

</odoo>