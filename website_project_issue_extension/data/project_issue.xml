<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- URL format for reading issue messages in portal -->
        <record id="icp_unread_messages_format_project_issue" model="ir.config_parameter">
            <field name="key">unread_messages_format.project_issue</field>
            <field name="value">/my/issues/:res_id</field>
        </record>

        <!-- Message polling interval in milliseconds -->
        <record id="project_issue_portal_polling_interval" model="ir.config_parameter">
            <field name="key">website_project_issue_extension.portal_polling_interval</field>
            <field name="value">30000</field>
        </record>

        <!-- Attachment maximum size in MB -->
        <record id="project_issue_attachment_max_size" model="ir.config_parameter">
            <field name="key">website_project_issue_extension.attachment_max_size</field>
            <field name="value">20</field>
        </record>
    </data>
</odoo>
