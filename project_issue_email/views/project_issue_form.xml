<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="project_issue_form_view_inherited" model="ir.ui.view">
        <field name="name">project.issue.form.view</field>
        <field name="model">project.issue</field>
        <field name="inherit_id" ref="project_issue.project_issue_form_view"/>
        <field name="arch" type="xml">
            <!-- Add button for attachements -->
            <button name="toggle_active" position="before">
                <button class="oe_stat_button" name="customer_issues_tree_view" type="object" icon="fa-ticket"
                    attrs="{'invisible': [('partner_id','=',False)]}">
                    <field string="Issues" name="customer_issue_count" widget="statinfo"/>
                </button>
            </button>

            <field name="name" position="attributes">
                <attribute name="placeholder">Issue's subject</attribute>
            </field>

            <field name="user_id" position="before">
                <field name="company_id" readonly="1" groups="base.group_user"/>
                <field name="preceding_issue_id" groups="base.group_user">
            </field>

            <!-- Hide partner related fields (they are moved to page) -->
            <field name="partner_id" position="replace"/>
            <field name="email_from" position="replace"/>

            <!-- Set project as required -->
            <field name="project_id" position="attributes">
                <attribute name="required">1</attribute>
            </field>

            <xpath expr="//notebook/page[1]" position="replace">
                <page string="Description">
                    <group name="issue" string="Issue">
                        <group col="2">
                            <field name="partner_id" colspan="2" required="1"/>
                            <field name="email_from" string="Recipient" colspan="2" readonly="1"/>
                        </group>
                        <group col="2">
                            <field name="date" colspan="2"/>
                            <field name="date_deadline" colspan="2"/>
                        </group>
                        <group col="4">
                            <field name="description" string="Issue's description" colspan="4" />
                            <field name="attachment_ids" widget="many2many_binary" colspan="4"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
