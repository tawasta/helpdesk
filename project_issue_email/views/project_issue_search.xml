<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_issue_filter" model="ir.ui.view">
        <field name="name">project.issue.search.view</field>
        <field name="model">project.issue</field>
        <field name="inherit_id" ref="project_issue.view_project_issue_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="issue_code" />
            </field>

            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', '|', ('issue_code', 'like', self), ('partner_id','child_of',self), ('description','ilike',self),('email_from','ilike',self),('name','ilike',self)]</attribute>
            </field>
        </field>
    </record>

</odoo>
