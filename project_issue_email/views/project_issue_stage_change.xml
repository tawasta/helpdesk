<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="project_issue_stage_change_tree" model="ir.ui.view">
        <field name="name">Issue stage changes tree view number</field>
        <field name="model">project.issue.stage.change</field>
        <field name="inherit_id" ref="project_issue_stage.project_issue_stage_change_tree"/>
        <field name="arch" type="xml">
            <field name="issue_partner_id" position="before">
                <field name="issue_number" />
            </field>
        </field>
    </record>

    <record id="project_issue_stage_change_filters" model="ir.ui.view">
        <field name="name">Issue stage changes filters view number</field>
        <field name="model">project.issue.stage.change</field>
        <field name="inherit_id" ref="project_issue_stage.project_issue_stage_change_filters"/>
        <field name="arch" type="xml">
            <field name="issue_partner_id" position="before">
                <field name="issue_number" />
            </field>
        </field>
    </record>

</odoo>