<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="project_issue_kanban_view" model="ir.ui.view">
        <field name="name">project.issue.kanban.view.issue.number</field>
        <field name="model">project.issue</field>
        <field name="inherit_id" ref="project_issue.project_issue_kanban_view"/>
        <field name="arch" type="xml">
            <field name="stage_id" position="after">
                <field name="issue_number" />
            </field>

            <xpath expr="//div[@class='oe_kanban_content']//field[@name='tag_ids']" position="before">
                <p style="margin-top: 0; font-size: 0.9em;"><strong>#<field name="issue_number"/></strong></p>
            </xpath>
        </field>
    </record>
</odoo>
