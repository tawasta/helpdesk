#. module: project_issue_attachment
#: code:addons/project_issue_attachment/models/project_issue.py:73
#, python-format
msgid ""
"<p class=\"oe_view_nocontent_create\">\n"
"                        Documents are attached to the issues.</p><p>\n"
"                        Send messages or log internal notes with attachments to link\n"
"                        documents to issues.\n"
"                    </p>"
msgstr ""
"<p class=\"oe_view_nocontent_create\">\n"
"                        Liitteet liitetään tukipyyntöihin.</p><p>\n"
"                        Voit lisätä liiteitä tukipyyntöön lähettämällä liitteitä viestien\n"
"                        tai sisäisten muistiinpanoja liitteenä.\n"
"                    </p>"

#. module: project_issue_attachment
#: code:addons/project_issue_attachment/models/project_project.py:73
#, python-format
msgid ""
"<p class=\"oe_view_nocontent_create\">\n"
"                        Documents are attached to the tasks and issues of your project.</p><p>\n"
"                        Send messages or log internal notes with attachments to link\n"
"                        documents to your project.\n"
"                    </p>"
msgstr ""
"<p class=\"oe_view_nocontent_create\">\n"
"                        Liitteet ovat liitettynä projektin tehtäviin tai tukipyyntöihin.</p><p>\n"
"                        Voit lisätä liiteitä projektiin lähettämällä liitteitä viestien\n"
"                        tai sisäisten muistiinpanoja liitteenä tukipyynnöissä tai tehtävissä.\n"
"                    </p>"

