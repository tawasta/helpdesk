<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.form.view.stage.changes</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <!-- Tree view to follow tasks lifecycle -->
            <notebook position="inside">
                <page string="Stage changes">
                    <group>
                        <field name="time_open" widget="float_time" />
                        <field name="stage_duration" widget="float_time" />
                    </group>
                    <field name="stage_change_ids">
                        <tree>
                            <field name='create_uid' />
                            <field name='start_date' />
                            <field name='end_date' />
                            <field name='old_stage_id' />
                            <field name='new_stage_id' />
                            <field name='hours' widget="float_time" />
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
