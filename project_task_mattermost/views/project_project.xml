<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edit_project" model="ir.ui.view">
        <field name="name">project.project.form.mattemorst</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <field name="privacy_visibility" position="before">
                <field name="use_mattermost_hooks" />
                <field
                    name="mattermost_hook_ids"
                    widget="many2many_tags"
                    options="{'no_quick_create': True, 'no_create': True}"
                    invisible="not use_mattermost_hooks"/>
                <field
                    name="mattermost_channel"
                    invisible="not use_mattermost_hooks"/>
                <field
                    name="mattermost_username"
                    invisible="not use_mattermost_hooks"/>
                <field
                    name="mattermost_icon_url"
                    invisible="not use_mattermost_hooks"/>
            </field>
        </field>
    </record>

</odoo>
