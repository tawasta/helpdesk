<odoo>
    <record id="view_task_portal_user_update_wizard" model="ir.ui.view">
        <field name="name">project.task.portal.access.updater.form</field>
        <field name="model">project.task.portal.access.updater</field>
        <field name="arch" type="xml">
            <form string="Update Portal Users on Tasks">

                    <p class="text-muted">
                        Users in the 'Suggested Portal Users to Add' column will be added to the task's
                        'Portal Users with Access' field if they are not there already. Suggestions are
                        based on who are the assignees and the followers of the task but can be modified
                        before confirming.
                    </p>
                    <p class="text-muted">
                        To skip modifying a task, you can uncheck the "Apply" column.
                    </p>

                    <field
                    name="line_ids"
                    options="{'no_open': True, 'no_create': True}"
                    nolabel="1"
                >
                        <tree delete="false" editable="top">
                            <field
                            name="task_id"
                            widget="many2one"
                            options="{'no_create': True}"
                        />
                            <field
                            name="current_user_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                            readonly="1"
                        />
                            <field
                            name="suggested_user_ids"
                            widget="many2many_tags"
                            options="{'no_create': True}"
                            domain="[('share', '=', True)]"
                        />
                            <field name="to_apply" />
                        </tree>
                    </field>

                <footer>
                    <button
                        string="Confirm"
                        type="object"
                        name="action_confirm"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
