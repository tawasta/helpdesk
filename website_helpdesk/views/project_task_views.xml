<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_task_form2" model="ir.ui.view">
        <field name="name">project.task.form</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">

            <notebook position="inside">
                <page string="Customer portal">
                    <group>
                        <group>
                            <field
                                name="portal_planned_hours"
                                widget="timesheet_uom_no_toggle"
                            />
                        </group>
                         <group>
                            <!-- TODO consider adding other limitations to
                            avoid accidental adding of wrong users -->
                            <field
                                name="allowed_portal_user_ids"
                                options="{'no_create': True}"
                                domain="[('share', '=', True)]"
                                widget="many2many_tags"
                            />
                        </group>
                    </group>
                    <group>
                        <field name="portal_description" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
