<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 
        Action for creating an opportunity from issue
    -->
    <act_window id="act_issue_to_opportunity"
        name="Create an Opportunity"
        src_model="project.issue"
        res_model="issue.to.opportunity"
        view_mode="form"
        target="new"
        key2="client_action_multi"/>

    <!-- 
        Add button for creating an opportunity from issue
    -->
    <record id="project_issue_form_view" model="ir.ui.view">
        <field name="name">project.issue.form.view</field>
        <field name="model">project.issue</field>
        <field name="inherit_id" ref="project_issue.project_issue_form_view"/>
        <field name="arch" type="xml">
            <field name="stage_id" position="before">
                <button name="%(act_issue_to_opportunity)d" string="Create an Opportunity"
                    type="action" class="oe_highlight" groups="base.group_user"/>
            </field>
        </field>
    </record>

</odoo>