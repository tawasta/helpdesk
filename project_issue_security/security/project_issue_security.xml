<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="project_issue_group_portal_user" model="res.groups">
            <field name="name">Issue Portal User</field>
            <field name="comment">The user has the right to create and view issues.</field>
        </record>

        <record id="project_project_rule_issue_portal_user" model="ir.rule">
            <field name="name">Project: issue portal users</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[('privacy_visibility', '=', 'portal')]</field>
            <field name="groups" eval="[(4, ref('project_issue_security.project_issue_group_portal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="project_issue_rule_issue_portal_user" model="ir.rule">
            <field name="name">Project issue: issue portal users</field>
            <field name="model_id" ref="project_issue.model_project_issue"/>
            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('project_issue_security.project_issue_group_portal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="project_task_rule_issue_portal_user" model="ir.rule">
            <field name="name">Project task: issue portal users</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('project_issue_security.project_issue_group_portal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="res_partner_rule_issue_portal_user" model="ir.rule">
            <field name="name">Res partner: issue portal users</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('project_issue_security.project_issue_group_portal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="account_analytic_account_rule_issue_portal_user" model="ir.rule">
            <field name="name">Account analytic account: issue portal users</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('project_issue_security.project_issue_group_portal_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
