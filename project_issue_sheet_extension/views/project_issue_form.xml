<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="project_issue_form_view_inherited" model="ir.ui.view">
        <field name="name">project.issue.form.view.inherited</field>
        <field name="model">project.issue</field>
        <field name="inherit_id" ref="project_issue_sheet.project_issue_form_view" />
        <field name="arch" type="xml">
            <field name="task_id"  position="after">
                <field name="suggested_message" invisible="1"/>
                <field name="suggested_time" invisible="1"/>
                <field name="suggested_task_id" invisible="0"/>
            </field>
            <field name="timesheet_ids"  position="attributes">
                <attribute name="context">{
                    'default_user_id' : uid,
                    'default_project_id': project_id,
                    'default_name': suggested_message,
                    'default_unit_amount': suggested_time,
                    'default_task_id': suggested_task_id,
                }</attribute>
            </field>

            <xpath expr="//tree/field[@name='project_id']" position="after">
                <field name="task_id" domain="[('project_id', '=', project_id)]"/>
            </xpath>
        </field>
    </record>
</odoo>
